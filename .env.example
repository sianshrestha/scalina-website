# Server-side settings. Locally: copy to .env.local. In production: set each one
# as a Worker secret, e.g. `npx wrangler secret put RESEND_API_KEY`, or in the
# Cloudflare dashboard (Workers > scalina-website > Settings > Variables).
# Public build-time values (site URL, Turnstile site key, analytics token)
# live in .env.production instead.
#
# At least one enquiry destination is required, or /start returns 502 on every
# submission (on purpose; see lib/deliverEnquiry.ts).

# Email via Resend (https://resend.com): verify scalinamedia.com first
RESEND_API_KEY=
ENQUIRY_TO=info@scalinamedia.com
ENQUIRY_FROM="Scalina Website <website@scalinamedia.com>"

# Cloudflare Turnstile SECRET key. When set, every enquiry must carry a valid
# Turnstile token, so NEXT_PUBLIC_TURNSTILE_SITE_KEY must be set too.
TURNSTILE_SECRET_KEY=

# Scalina CRM (later): POSTs the enquiry JSON with its reference
SCALINA_CRM_ENDPOINT=
SCALINA_CRM_TOKEN=
