/* Cloudflare Workers config for the OpenNext adapter (@opennextjs/cloudflare).
   Build and deploy with `npm run deploy`; test the Workers runtime locally with
   `npm run preview`. Secrets (RESEND_API_KEY, TURNSTILE_SECRET_KEY, ...) are set
   with `npx wrangler secret put NAME` or in the dashboard, never in this file. */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scalina-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "scalina-website"
    }
  ],
  /* next/image optimisation through Cloudflare Images (5,000 unique
     transformations a month are free). */
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
