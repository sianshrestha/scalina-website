# Public values for production builds (`npm run deploy` / Workers Builds).
# NEXT_PUBLIC_* are inlined into the browser bundle at BUILD time, so they are
# public by design. NEVER put a secret in this file: secrets go in the Worker
# with `npx wrangler secret put NAME` (see .env.example).

# The address the site is served from: canonical URLs, sitemap, share images.
NEXT_PUBLIC_SITE_URL=https://scalinamedia.com

# Cloudflare Turnstile SITE key (Dashboard > Turnstile > your widget).
# Must be set if TURNSTILE_SECRET_KEY is set on the Worker, or every enquiry
# is refused.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Web Analytics beacon token (Dashboard > Analytics & Logs > Web
# Analytics > Add a site > manual JS snippet: the "token" value). Leave empty
# if you turn on automatic injection for the domain instead.
NEXT_PUBLIC_CF_BEACON_TOKEN=
